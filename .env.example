# FieldWeaver local configuration. Copy to .env and fill values locally.
# Never commit .env or place a real key in this file.

# Primary live inference provider. Leave blank to use the explicit offline mock.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Provider behaviour. Timeout in seconds, retries apply only to transient errors.
FIELDWEAVER_MODEL_TIMEOUT_S=30
FIELDWEAVER_MODEL_MAX_RETRIES=1

# Agent loop hard limits (server-side, cannot be raised by model output).
FIELDWEAVER_MAX_REPLANS=2
FIELDWEAVER_MAX_MODEL_CALLS=2

# Browser-facing API origin used by the Next.js dev server.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
